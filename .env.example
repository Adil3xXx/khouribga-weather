# انسخ هذا الملف إلى .env ثم املأ القيمتين
#   cp .env.example .env  &&  chmod 600 .env
#
# 1) TELEGRAM_BOT_TOKEN  ->  من @BotFather بـ /newbot  (شكله 123456789:AAF-....)
# 2) TELEGRAM_CHAT_ID    ->  رقم محادثتك  (أو @username_قناة بعد إضافة البوت إليها كمشرف)
#    للحصول على رقمك: أرسل /start للبوت ثم افتح
#    https://api.telegram.org/bot<TOKEN>/getUpdates  ->  "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# اختياري / optional
MESSAGE_LANGUAGE=ar          # ar | fr | en
WEATHER_LAT=32.88108         # خريبكة
WEATHER_LON=-6.90630
WEATHER_TZ=Africa/Casablanca
HTTP_TIMEOUT=25
RETRIES=4
